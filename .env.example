# Required: HuggingFace token for pyannote diarization
# Get one at: https://hf.co/settings/tokens
# Also accept license at: https://hf.co/pyannote/speaker-diarization-community-1
HF_TOKEN=

# Optional: Deepgram API key for fallback transcription
# Get one at: https://console.deepgram.com/signup ($200 free credit)
DEEPGRAM_API_KEY=

# Optional: Override defaults
# WHISPER_MODEL=large-v2
# WHISPER_DEVICE=auto
# WHISPER_BATCH_SIZE=16
